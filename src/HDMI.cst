// Tang Nano 9K (GW1NR-LV9QN88PC6/I5)
// HDMI pairs sit in Bank 1, which is hard-wired to 3.3 V on this board.
// Do NOT set IO_TYPE=LVCMOS18D — that forces BANK_VCCIO=1.8 and causes CT1136.
// Let ELVDS_OBUF set the differential IO standard; only set pull/drive here.

IO_LOC "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "sys_rst_n" 4;
IO_PORT "sys_rst_n" PULL_MODE=UP;

IO_LOC "tmds_d_p[0]" 71,70;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 73,72;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 75,74;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_clk_p" 69,68;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
